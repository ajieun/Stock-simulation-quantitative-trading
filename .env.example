# 复制为 .env 后填写真实值，.env 已在 .gitignore 中排除

# DeepSeek 开放平台密钥（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖 config.yaml 中的模型
# DEEPSEEK_MODEL=deepseek-chat

# 可选：QMT 资金账号（也可以在 config.yaml 里配置）
# QMT_ACCOUNT_ID=你的资金账号

# 可选：Web 面板管理口令，留空则不校验（仅监听 127.0.0.1）
# DASHBOARD_TOKEN=
